{
  "$schema": "https://schema.tauri.app/config/2",
  "identifier": "ai.careerpilot.desktop",
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "CareerPilot AI",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640,
        "center": true
      }
    ],
    "security": {
      "freezePrototype": true,
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob:",
        "font-src": "'self'",
        "connect-src": "'self' ipc: http://ipc.localhost https://api.careerpilot.example",
        "object-src": "'none'",
        "base-uri": "'self'",
        "frame-ancestors": "'none'",
        "form-action": "'none'"
      }
    }
  }
}
