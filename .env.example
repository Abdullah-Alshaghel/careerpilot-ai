# CareerPilot AI — local development environment.
# Create `.env` with generated secrets:  python scripts/init-env.py
# (or copy this file and replace every value). `.env` is git-ignored.
# Use URL-safe characters (letters, digits, - _) in passwords: they are
# embedded in connection URLs.

ENVIRONMENT=local
LOG_LEVEL=INFO

# --- PostgreSQL (one database + role per service) ---
POSTGRES_USER=careerpilot_admin
POSTGRES_PASSWORD=change-me-postgres-admin
# Host port; 5432 is often taken by a locally installed Postgres.
POSTGRES_HOST_PORT=55432
IDENTITY_DB_PASSWORD=change-me-identity-db
DOCUMENTS_DB_PASSWORD=change-me-documents-db
CAREER_PROFILE_DB_PASSWORD=change-me-career-profile-db
COMPANIES_DB_PASSWORD=change-me-companies-db

# --- Identity: access-token signing key ---
# Ed25519 private key seed (32 bytes, base64url). Generate with
#   python scripts/init-env.py --update
# Only the Identity Service receives it; everything else verifies tokens with
# the public key from Identity's JWKS endpoint.
JWT_SIGNING_KEY=change-me-generated-by-init-env

# --- RabbitMQ ---
RABBITMQ_USER=careerpilot
RABBITMQ_PASSWORD=change-me-rabbitmq

# --- Redis ---
REDIS_PASSWORD=change-me-redis

# --- S3-compatible object storage (SeaweedFS locally) ---
S3_ACCESS_KEY=change-me-s3-access
S3_SECRET_KEY=change-me-s3-secret-key
S3_BUCKET_DOCUMENTS=careerpilot-documents

# --- API gateway ---
GATEWAY_HOST_PORT=8080
# Exact origins only (no wildcards). Desktop: tauri://localhost (macOS),
# http://tauri.localhost (Windows), http://localhost:1420 (Vite dev).
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:1420,http://tauri.localhost,tauri://localhost

# Optional rate-limit overrides (defaults are production values):
# RATE_LIMIT_LOGIN_PER_IP=20
# RATE_LIMIT_LOGIN_FAILURES_PER_ACCOUNT=5
# RATE_LIMIT_REGISTER_PER_IP=10

# --- Web server-side (Next.js route handlers; never sent to the browser) ---
# Gateway URL as seen from the Next.js server. Defaults to NEXT_PUBLIC_API_BASE_URL.
# API_INTERNAL_BASE_URL=http://127.0.0.1:8080

# --- Observability (optional: docker compose --profile observability up) ---
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-lgtm:4318

# --- Client build-time config (PUBLIC values only — never secrets) ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
VITE_API_BASE_URL=http://localhost:8080
